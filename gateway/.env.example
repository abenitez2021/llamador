# Copiar este archivo como gateway/.env (NO subir el .env real a GitHub).
# Puerto COM identificado en Windows. Cerrar el Monitor Serie antes de iniciar.
PLC_PORT=COM10
PLC_BAUD_RATE=115200
PLC_CONTROLLER_ID=PLC-01

# IMPORTANTE: API_PORT en back/.env determina el puerto.
# Si el backend utiliza API_PORT=7001, cambiar :5000 por :7001.
# Debe terminar en /api para coincidir con NestJS app.setGlobalPrefix('api').
ENTER_API_URL=http://127.0.0.1:5000/api

# Misma clave privada de 32+ caracteres configurada en back/.env:
ENTER_PLC_KEY=REEMPLAZAR_POR_LA_MISMA_CLAVE_SEGURA_DE_BACKEND

# Node usa el archivo .env automáticamente mediante dotenv.
# Variables $env: previas de PowerShell tienen prioridad sobre este archivo.
